{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.2",
      "config": {
        "buildCommand": "composer install --no-dev --optimize-autoloader && php artisan config:clear && php artisan view:clear"
      }
    }
  ],
  "routes": [
    {
      "src": "/(css|js|images|icon.png|manifest.json|favicon.png)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
