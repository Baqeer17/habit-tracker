{
    "version": 2,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|icon.png|manifest.json|favicon.png)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
